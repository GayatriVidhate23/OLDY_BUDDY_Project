# OLDY BUDDY BACKEND CONFIGURATION

# SECRET KEYS
# Required for production. Must be a long, securely generated string.
JWT_SECRET_KEY=<generate_a_strong_random_secret_here>

# DATABASE
# Default uses local SQLite for development
# DATABASE_URL=postgresql+asyncpg://user:password@localhost/oldybuddy

# MODULE 6 - NOTIFICATIONS CONFIGURATION
NOTIFY_PROVIDER_TYPE=console # 'console' for dev/tests, 'plivo' for production SMS
EXPO_PUSH_TOKEN_URL=https://exp.host/--/api/v2/push/send
PLIVO_AUTH_ID=your_plivo_auth_id
PLIVO_AUTH_TOKEN=your_plivo_auth_token
PLIVO_SENDER_ID=OLDYBUDDY
WARNING_SMS_DELAY_MINUTES=15
MAX_NOTIFICATION_RETRIES=3

